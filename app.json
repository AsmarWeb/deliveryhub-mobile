{
  "expo": {
    "name": "Raslo",
    "slug": "deliveryhub-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/raslo-icon.png",
    "scheme": "deliveryhubmobile",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/brand/raslo-icon.png",
      "bundleIdentifier": "com.anonymous.deliveryhub-mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#123D35",
        "foregroundImage": "./assets/brand/raslo-adaptive.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.asmarweb.deliveryhub",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/raslo-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#123D35",
          "image": "./assets/brand/raslo-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "اسمح لرسلو باختيار صور المستندات وإثبات التسليم. Allow Raslo to choose document and delivery photos.",
          "cameraPermission": "اسمح لرسلو بتصوير مستنداتك وإثبات التسليم. Allow Raslo to photograph documents and delivery proof.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "61936adc-7439-441f-a258-a6b1dcabed36"
      }
    },
    "owner": "asmarweb"
  }
}
